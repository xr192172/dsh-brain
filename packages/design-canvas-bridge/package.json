{
  "name": "@dsh-brain/design-canvas-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "description": "design-canvas 原生接入桥：DSH 通过 @deepseek-ai/dsh-mcp-client 把 design-canvas 的 MCP 工具注册到 ctx.tools（mcp__design-canvas__*），本插件在选中工作区时自动调用 import_project 预热 tree-sitter AST + 符号索引。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}