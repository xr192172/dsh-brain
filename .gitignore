# ===== 敏感：绝不被提交 =====
.env
*.env
.env.*
*.pem
*.key
*.p12
id_rsa*
*.credential
*.token

# ===== 依赖 / 运行时 / 本地工具 =====
node_modules/
.tools/
out/
logs/
.design-canvas/
# ★ 2026-09-28：主仓改名 design-canvas → agent-io，运行时数据目录随之改名。
#   两个都留：旧名在既有数据布局里仍可能出现（如 .agent-io/.design-canvas/）。
.agent-io/
**/dist/
**/lib/
*.tsbuildinfo
.tmp-*/

# ===== 归档 / 二进制打包 =====
*.tgz
*.zip
*.rar

# ===== 堆快照（V8 heap，单个 50~70MB，绝不是资产） =====
heap-*.heapsnapshot

# ===== camera 埋点运行时事件流（18MB+，可持续增长） =====
.agent/camera/

# ===== design-canvas 开发 fork（从 Downloads 克隆 fork 进来，不入库） =====
/design-canvas-dev/

# @dsh-brain 分包产物（junction-link 到 profile node_modules，构建产物不入库）
packages/*/node_modules/

# ===== 一次性 / AI 会话残留脚本 =====
_read_session.mjs
test_resolve.js
test_resolve.mjs
_probe_*.mjs
_probe_tools.mjs

# ===== IDE / OS =====
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
# ───── 实验内核构建产物（不入库） ─────
# `scripts/build-experiment-kernel.mjs --out <此目录>` 的输出：复制 src + patch + junction + tsc 出 dist。
# ★ 脚本每次重建前会先 rmSync 它 ⇒ 它是**可随时重建的产物**，入库会让下一个人误以为是源码。
/expt-kernel/
